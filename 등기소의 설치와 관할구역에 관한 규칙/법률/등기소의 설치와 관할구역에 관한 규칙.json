        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 규칙은 법원조직법 제4조제2항에 의하여 지방법원 관내에 등기소의 설치와 그 관할구역을 정함을 목적으로 한다.",
        "enforcement_date": "19810701",
        "relations": [],
        "revision_type": "일부개정",
        "changed": "N",
        "article_key": "0001001",
        "moved": "000000",
