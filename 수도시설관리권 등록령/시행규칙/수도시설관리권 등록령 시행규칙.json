      },
      {
        "article_no": "제11조",
        "article_title": "신청서의 조사",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(신청서의 조사) 등록공무원이 신청서를 접수한 때에는 지체없이 신청에 관한 모든사항을 조사하여야 한다.",
        "enforcement_date": "20041129",
        "relations": [],
