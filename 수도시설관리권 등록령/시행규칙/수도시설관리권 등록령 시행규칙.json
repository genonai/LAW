      },
      {
        "article_no": "제12조",
        "article_title": "채권분할로 인한 저당권의 변경등록",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(채권분할로 인한 저당권의 변경등록) 채권의 분할로 인한 저당권의 변경등록을 신청하는 경우에는 신청서에 그 분할된 각 채권액을 기재하여야 한다.",
        "enforcement_date": "20041129",
        "relations": [],
        "revision_type": "타법개정",
        "changed": "N",
