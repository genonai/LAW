      },
      {
        "article_no": "제8조의2",
        "article_title": "국제경연대회의 범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조의2 (국제경연대회의 범위) 법 제10조에서 \"대통령령이 정하는 국제경연대회\"라 함은 15개국이상이 참가하여 10회이상 개최하여 온 문화예술부문의 권위있는 대회 및 기타 문화부장관이 인정하는 대회를 말한다.<개정 1990ㆍ1ㆍ3>",
        "enforcement_date": "19900103",
        "relations": [],
        "note": "[본조신설 1988ㆍ6ㆍ8]",
        "revision_type": "타법개정",
