      {
        "article_no": "제9조",
        "article_title": "중요시설등의 용역경비",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(중요시설등의 용역경비) 기관ㆍ시설 또는 사업장에 청원경찰에 의한 경비와 용역경비가 동시에 실시되는 경우에는 청원주는 경비의 효율화를 위하여 청원경찰에 대한 근무배치 및 감독에 관한 권한을 용역경비업자에게 위임할 수 있다.",
        "enforcement_date": "19980101",
        "relations": [],
        "revision_type": "타법개정",
        "changed": "N",
        "article_key": "0009001",
        "images": [],
