      {
        "article_no": "제16조",
        "article_title": "추가공탁등의 신고",
        "chapter": "",
        "chapter_path": "",
        "content": "제16조 (추가공탁등의 신고) 용역경비업자는 영 제29조의 규정에 의하여 추가로 공탁하거나 이행보증보험 또는 공제에 가입한 때에는 15일이내에 별지 제7호서식에 의한 신고서를 허가관청에 제출하여야 한다.",
        "enforcement_date": "19960715",
        "relations": [],
        "revision_type": "전부개정",
        "changed": "Y",
        "article_key": "0016001",
        "moved": "000000",
