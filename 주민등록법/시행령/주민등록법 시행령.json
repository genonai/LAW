      },
      {
        "article_no": "제2조",
        "article_title": "주민등록표의 서식",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (주민등록표의 서식) 법 제7조의 규정에 의한 주민등록표는 별지 제1호서식에 의한다",
        "enforcement_date": "19620620",
        "relations": [],
        "revision_type": "제정",
        "changed": "Y",
        "article_key": "0002001",
        "moved": "000000",
