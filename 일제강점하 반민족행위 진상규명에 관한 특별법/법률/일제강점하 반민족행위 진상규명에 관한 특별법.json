        "chapter": "",
        "chapter_path": "",
        "content": "제6조 (의결정족수) 위원회는 재적위원 과반수의 찬성으로 의결한다.",
        "enforcement_date": "20040923",
        "relations": [],
        "revision_type": "제정",
        "changed": "Y",
        "article_key": "0006001",
        "moved": "000000",
