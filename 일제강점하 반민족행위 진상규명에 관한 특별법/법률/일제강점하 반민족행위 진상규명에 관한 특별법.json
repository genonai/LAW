      },
      {
        "article_no": "제7조",
        "article_title": "위원회의 활동기간",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조 (위원회의 활동기간) 위원회는 그 구성을 마친 날부터 3년 이내에 활동을 완료하여야 한다.",
        "enforcement_date": "20040923",
        "relations": [],
        "revision_type": "제정",
        "changed": "Y",
        "article_key": "0007001",
        "moved": "000000",
