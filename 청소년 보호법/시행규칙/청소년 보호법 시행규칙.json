      },
      {
        "article_no": "제2조",
        "article_title": "청소년유해물건·업소의 고시",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조 (청소년유해물건ㆍ업소의 고시) 청소년보호위원회는 청소년보호법시행령(이하 \"영\"이라 한다) 제2조 및 제3조의 규정에 의하여 성기구ㆍ완구류 또는 업소에 대하여 청소년에게 명백하게 유해하다고 결정한 경우에는 이를 관보에 고시하여야 한다.",
        "enforcement_date": "19970707",
        "relations": [],
        "revision_type": "제정",
        "changed": "Y",
        "article_key": "0002001",
        "moved": "000000",
