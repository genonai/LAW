        "chapter": "",
        "chapter_path": "",
        "content": "제1조 (목적) 이 영은 다중이용시설등의실내공기질관리법에서 위임된 사항과 그 시행에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "20040530",
        "relations": [],
        "revision_type": "전부개정",
        "changed": "Y",
